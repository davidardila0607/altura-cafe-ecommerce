# nginx para la tienda (plantilla: la imagen oficial reemplaza ${PORT} al arrancar).
server {
    # Railway indica el puerto en la variable PORT.
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;

    # Archivos con huella en el nombre (main-H7MQID23.js, chunk-…, styles-….css, media/…):
    # si el contenido cambia, cambia el nombre, así que se guardan en caché un año.
    location ~* "^/[a-z-]+-[A-Za-z0-9_-]{8,}\.(js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location /media/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # index.html nunca se guarda en caché: así cada visita recibe los nombres nuevos.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Es una SPA: /productos, /login, /admin… no existen como archivos. Si no hay archivo con ese
    # nombre, se entrega index.html y Angular dibuja la ruta (así funcionan al recargar).
    location / {
        add_header Cache-Control "public, max-age=3600";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri $uri/ /index.html;
    }
}
